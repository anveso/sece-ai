# ---------------------------------------------------------------------------
# SECE AI - environment configuration
# Copy this file to .env and fill in real values before running docker-compose.
# ---------------------------------------------------------------------------

# --- App ---
APP_NAME="SECE AI"
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Database (Postgres + pgvector) ---
POSTGRES_USER=sece
POSTGRES_PASSWORD=sece_dev_password
POSTGRES_DB=sece_ai
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://sece:sece_dev_password@db:5432/sece_ai

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM (OpenAI) ---
OPENAI_API_KEY=sk-...
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Web search tool (optional, Tavily) ---
# Leave blank to disable the web_search tool.
TAVILY_API_KEY=

# --- File storage ---
# Local disk for the MVP; swap for MinIO/S3 later (see README roadmap).
UPLOAD_DIR=/data/uploads

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
